#!/bin/sh
set -e

RELEASE_REPOSITORY="beacon-observability/beacon-dotnet"
RELEASE_WORKFLOW="$RELEASE_REPOSITORY/.github/workflows/beacon-release.yml"

test -z "$OTEL_DOTNET_AUTO_HOME" && OTEL_DOTNET_AUTO_HOME="$HOME/.otel-dotnet-auto"

print_usage() {
  cat <<'EOF'
Usage: otel-dotnet-auto-install.sh [--uninstall | --help]

With no option, installs Beacon .NET Automatic Instrumentation.
  --uninstall  Removes the installation from OTEL_DOTNET_AUTO_HOME.
  --help       Shows this help text.
EOF
}

assert_safe_install_path() {
  target_dir="$1"
  case "$target_dir" in
    ""|"/"|"."|".."|"$HOME")
      echo "Refusing to modify unsafe installation path '$target_dir'." >&2
      return 1
      ;;
  esac

  if [ -d "$target_dir" ]; then
    canonical_target_dir=$(CDPATH= cd -P "$target_dir" && pwd)
    case "$canonical_target_dir" in
      "/"|"$HOME")
        echo "Refusing to modify unsafe installation path '$canonical_target_dir'." >&2
        return 1
        ;;
    esac
  fi
}

uninstall_opentelemetry() {
  uninstall_dir="$OTEL_DOTNET_AUTO_HOME"
  assert_safe_install_path "$uninstall_dir"

  if [ ! -e "$uninstall_dir" ]; then
    echo "Beacon .NET Automatic Instrumentation is already uninstalled from '$uninstall_dir'."
    return 0
  fi

  uninstall_dir=$(CDPATH= cd -P "$uninstall_dir" && pwd)

  if [ ! -f "$uninstall_dir/BEACON-METADATA.json" ]; then
    echo "Refusing to remove '$uninstall_dir': BEACON-METADATA.json was not found." >&2
    return 1
  fi

  rm -rf -- "$uninstall_dir"
  echo "Beacon .NET Automatic Instrumentation was removed from '$uninstall_dir'."
  echo "Start a new shell before launching applications that should not be instrumented."
}

case "${1:-}" in
  "")
    ;;
  --uninstall)
    if [ "$#" -ne 1 ]; then
      print_usage >&2
      exit 1
    fi
    uninstall_opentelemetry
    exit 0
    ;;
  --help|-h)
    print_usage
    exit 0
    ;;
  *)
    print_usage >&2
    exit 1
    ;;
esac

assert_release_version() {
  if ! printf '%s\n' "$1" | grep -Eq '^beacon-v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?$'; then
    echo "Invalid release version '$1'. Expected beacon-vMAJOR.MINOR.PATCH or beacon-vMAJOR.MINOR.PATCH-PRERELEASE (for example, beacon-v0.2.0-beta.1)." >&2
    return 1
  fi
}

get_github_cli_path() {
  if ! command -v gh > /dev/null 2>&1; then
    echo "The GitHub CLI ('gh') is required to verify release assets. Install it from https://cli.github.com/ or set SKIP_RELEASE_VERIFICATION=true to explicitly skip verification." >&2
    return 1
  fi

  command -v gh
}

assert_release_asset() {
  verify_github_cli_path="$1"
  verify_version="$2"
  verify_asset_path="$3"
  verify_asset_name="${verify_asset_path##*/}"

  if [ ! -f "$verify_asset_path" ]; then
    echo "Could not find release asset '$verify_asset_path'." >&2
    return 1
  fi

  # Verify that the expected workflow produced this exact file from the release tag.
  if ! "$verify_github_cli_path" attestation verify "$verify_asset_path" \
    --repo "$RELEASE_REPOSITORY" \
    --signer-workflow "$RELEASE_WORKFLOW" \
    --source-ref "refs/tags/$verify_version"; then
    echo "GitHub artifact attestation verification failed for '$verify_asset_name'." >&2
    return 1
  fi
}

# guess OS_TYPE if not provided
if [ -z "$OS_TYPE" ]; then
  case "$(uname -s | tr '[:upper:]' '[:lower:]')" in
    cygwin_nt*|mingw*|msys_nt*)
      OS_TYPE="windows"
      ;;
    linux*)
      if [ "$(ldd /bin/ls | grep -m1 'musl')" ]; then
        OS_TYPE="linux-musl"
      else
        OS_TYPE="linux-glibc"
      fi
      ;;
    darwin*)
      OS_TYPE="macos"
      ;;
  esac
fi

case "$OS_TYPE" in
  "linux-glibc"|"linux-musl"|"macos"|"windows")
    ;;
  *)
    echo "Set the operating system type using the OS_TYPE environment variable. Supported values: linux-glibc, linux-musl, macos, windows." >&2
    exit 1
    ;;
esac

# guess OS architecture if not provided
if [ -z "$ARCHITECTURE" ]; then
  case $(uname -m) in
    x86_64)  ARCHITECTURE="x64" ;;
    aarch64|arm64) ARCHITECTURE="arm64" ;;
  esac
fi

case "$ARCHITECTURE" in
  "x64"|"arm64")
    ;;
  *)
    echo "Set the architecture type using the ARCHITECTURE environment variable. Supported values: x64, arm64." >&2
    exit 1
    ;;
esac

if [ "$OS_TYPE" = "macos" ] && [ "$ARCHITECTURE" != "arm64" ]; then
  echo "Beacon .NET currently supports macOS on arm64 only." >&2
  exit 1
fi

if [ "$OS_TYPE" = "windows" ] && [ "$ARCHITECTURE" != "x64" ]; then
  echo "Beacon .NET currently supports the Windows archive on x64 hosts only." >&2
  exit 1
fi

if command -v curl > /dev/null 2>&1; then
  DOWNLOADER="curl -sSfLo"
elif command -v wget > /dev/null 2>&1; then
  DOWNLOADER="wget -qO"
else
  echo "Error: Neither curl nor wget is available." >&2
  exit 1
fi

test -z "$VERSION" && VERSION="beacon-v{{VERSION}}"

assert_release_version "$VERSION"

GITHUB_CLI_PATH=""
if [ "${SKIP_RELEASE_VERIFICATION:-false}" = "true" ]; then
  echo "Warning: GitHub artifact attestation verification is skipped. The ZIP archive will not be verified." >&2
else
  GITHUB_CLI_PATH="$(get_github_cli_path)"
fi

RELEASE_DOWNLOAD_DIR="$(mktemp -d "${TMPDIR:-/tmp}/otel-dotnet-auto.XXXXXX")"
cleanup_release_download_dir() {
  rm -rf "$RELEASE_DOWNLOAD_DIR"
}
trap cleanup_release_download_dir 0

if [ -z "${DOWNLOAD_DIR:-}" ]; then
  DOWNLOAD_DIR="$RELEASE_DOWNLOAD_DIR"
fi

RELEASES_URL="https://github.com/$RELEASE_REPOSITORY/releases"
PRODUCT_VERSION="${VERSION#beacon-v}"
ARCHIVE="beacon-dotnet-auto-$PRODUCT_VERSION-$OS_TYPE.zip"

# In case of Linux, use architecture in the download path
if echo "$OS_TYPE" | grep -q "linux"; then
  ARCHIVE="beacon-dotnet-auto-$PRODUCT_VERSION-$OS_TYPE-$ARCHITECTURE.zip"
fi

LOCAL_PATH="${LOCAL_PATH:=$DOWNLOAD_DIR/$ARCHIVE}"
if [ ! -f "${LOCAL_PATH}" ]; then
  (
    cd "$DOWNLOAD_DIR"
    echo "Downloading $VERSION for $OS_TYPE ($LOCAL_PATH)..."
    ${DOWNLOADER} "$LOCAL_PATH" "$RELEASES_URL/download/$VERSION/$ARCHIVE"
  )
else
  echo "Using local installation archive: $LOCAL_PATH"
fi

ARCHIVE_PATH="$RELEASE_DOWNLOAD_DIR/$ARCHIVE"
if [ "$LOCAL_PATH" != "$ARCHIVE_PATH" ]; then
  cp "$LOCAL_PATH" "$ARCHIVE_PATH"
fi

if [ "${SKIP_RELEASE_VERIFICATION:-false}" != "true" ]; then
  assert_release_asset "$GITHUB_CLI_PATH" "$VERSION" "$ARCHIVE_PATH"
fi

assert_safe_install_path "$OTEL_DOTNET_AUTO_HOME"
rm -rf "$OTEL_DOTNET_AUTO_HOME"
unzip -q "$ARCHIVE_PATH" -d "$OTEL_DOTNET_AUTO_HOME"

if [ -f "$OTEL_DOTNET_AUTO_HOME/instrument.sh" ]; then
  chmod +x "$OTEL_DOTNET_AUTO_HOME/instrument.sh"
fi

cat > "$OTEL_DOTNET_AUTO_HOME/uninstall.sh" <<'EOF'
#!/bin/sh
set -e

install_dir=$(CDPATH= cd -P "$(dirname "$0")" && pwd)

case "$install_dir" in
  "/"|"$HOME")
    echo "Refusing to uninstall from unsafe path '$install_dir'." >&2
    exit 1
    ;;
esac

if [ ! -f "$install_dir/BEACON-METADATA.json" ]; then
  echo "Refusing to remove '$install_dir': BEACON-METADATA.json was not found." >&2
  exit 1
fi

rm -rf -- "$install_dir"
echo "Beacon .NET Automatic Instrumentation was removed from '$install_dir'."
echo "Start a new shell before launching applications that should not be instrumented."
EOF
chmod +x "$OTEL_DOTNET_AUTO_HOME/uninstall.sh"
